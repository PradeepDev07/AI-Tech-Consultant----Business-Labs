# ==============================================================================
# Task 2: Inbox Agent Configuration (.env.example)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Task 1 Knowledge Brain API Endpoint
TASK1_API_BASE_URL=http://localhost:8000
# Optional bearer token if Task 1 has API_AUTH_TOKEN configured
TASK1_API_KEY=

# Model Provider Configuration
# Supported Options: "mock" (offline double), "ollama" (local), "claude" (Anthropic Messages API)
MODEL_PROVIDER=mock
MODEL_NAME=mock-inbox-model

# Local Ollama Configuration (Required only when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=smollm:135m

# Anthropic Claude API Configuration (Required only when MODEL_PROVIDER=claude)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# HTTP Client & Retries for Task 1 Calls
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# Persistence Directory (stores emails.json, eligibility.json, feedback.json)
STORAGE_DIR=storage

# Autonomous Email Sending Safeguard
# Keep false during development and evaluation. Autonomous sending is strictly gated
# behind 20 consecutive unchanged human reviews and policy checks.
EMAIL_SEND_ENABLED=false
