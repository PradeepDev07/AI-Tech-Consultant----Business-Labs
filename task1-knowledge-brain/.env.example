# ==============================================================================
# Task 1: Knowledge Brain Configuration (.env.example)
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Storage Locations (relative paths resolve to task1-knowledge-brain/)
SQLITE_DB_PATH=storage/knowledge_brain.db
CHROMA_PERSIST_DIR=storage/chroma_db
IMAGE_CACHE_DIR=storage/images

# Sitemap Ingestion & Polite Crawler Settings
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
CRAWLER_CONCURRENCY=3
CRAWLER_REQUEST_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=15.0
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_FACTOR=1.5
CRAWLER_USER_AGENT=KnowledgeBrainBot/1.0 (+https://support.brilliantdirectories.com)

# In-Process Periodic Scheduler Settings
SCHEDULED_INGESTION_ENABLED=false
SCHEDULED_INGESTION_INTERVAL_HOURS=24.0

# Chunking & Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MIN_EVIDENCE_THRESHOLD=0.35

# LLM Model Provider
# Supported Options: "mock" (offline double), "ollama" (local), "anthropic" (Claude API)
MODEL_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=mock-model-v1

# Anthropic Claude API Configuration (Required only when MODEL_PROVIDER=anthropic)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Embedding Provider
# Supported Options: "mock" (deterministic vectors), "ollama", "chroma_default"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-128

# Multimodal Vision Provider
# Supported Options: "none" (honestly unavailable), "mock", "ollama", "ocr" (local offline OCR)
VISION_PROVIDER=none
VISION_MODEL=llava:latest

# Security & API Authentication
# Optional bearer token for protected endpoints. Leave empty to allow unauthenticated access in dev.
API_AUTH_TOKEN=
