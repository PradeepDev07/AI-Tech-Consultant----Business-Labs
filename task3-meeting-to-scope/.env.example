# ==============================================================================
# Task 3: Meeting to Scope Agent Configuration (.env.example)
# ==============================================================================

# Server Configuration
PORT=8002
HOST=0.0.0.0
ENVIRONMENT=development

# Task 1 Knowledge Brain API Endpoint
TASK1_API_BASE_URL=http://localhost:8000
TASK1_API_TIMEOUT_SECONDS=10.0
TASK1_MAX_RETRIES=3

# Model Provider Configuration
# Supported Options: "mock" (offline double), "ollama" (local), "anthropic" (Claude API)
MODEL_PROVIDER=mock
MODEL_NAME=mock-scope-model

# Local Ollama Configuration (Required only when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=smollm:135m

# Anthropic Claude API Configuration (Required only when MODEL_PROVIDER=anthropic)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# SQLite Database Location (resolves relative to task3-meeting-to-scope/)
DATABASE_PATH=storage/meeting_to_scope.db

# Safety & Input Limits
MAX_TRANSCRIPT_LENGTH=50000
